<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

    <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
    
    <!-- UR Manipulator Arguments -->
    <xacro:arg name="joint_limit_params" default="$(find container_unloading_sim_benchmark)/config/ur30/joint_limits.yaml"/>
    <xacro:arg name="kinematics_params" default="$(find container_unloading_sim_benchmark)/config/ur30/default_kinematics.yaml"/>
    <xacro:arg name="physical_params" default="$(find ur_description)/config/ur30/physical_parameters.yaml"/>
    <xacro:arg name="visual_params" default="$(find ur_description)/config/ur30/visual_parameters.yaml"/>
    <xacro:arg name="force_abs_paths" default="true"/>

    <xacro:macro name="ur30_macro" params="parent translation_xyz orientation_rpy">
        <xacro:ur_robot
            name="ur30"
            parent="${parent}"
            tf_prefix=""
            joint_limits_parameters_file="$(arg joint_limit_params)"
            kinematics_parameters_file="$(arg kinematics_params)"
            physical_parameters_file="$(arg physical_params)"
            visual_parameters_file="$(arg visual_params)"
            force_abs_paths="$(arg force_abs_paths)"
            >
            <origin xyz="${translation_xyz}" rpy="${orientation_rpy}"/>
        </xacro:ur_robot>
    </xacro:macro>

</robot>
