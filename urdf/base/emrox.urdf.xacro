<?xml version="1.0" ?>
<!--
Author: Pradheep Padmanabhan
Contributor: Adarsh Karan K P
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rox">
<!-- This is the main URDF file for rox robot -->

  <xacro:macro name="rox_macro" params="">
    <!-- Xacro Properties-->
    <xacro:property name="imu" value="false"/>
    <xacro:property name="ur_dc" value="false"/>
    <xacro:property name="joint_typ" value="fixed"/>

    <!-- Include xacro files -->
    <xacro:include filename="$(find rox_description)/urdf/xacros/frame.xacro" />

    <!-- Nanoscan -->
    <xacro:include filename="$(find rox_description)/urdf/xacros/sick_nanoscan.xacro" />

    <!-- Building the robot from here -->
    <link name="emrox/base_link" />

    <xacro:rox_base 
      name="emrox/base_footprint"  
      parent="emrox/base_link"
      >
      <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:rox_base>

    <xacro:include filename="$(find rox_description)/urdf/xacros/argo_drive.xacro" />
    <xacro:argo_drive parent="emrox/base_link"/>

    <xacro:sick_nanoscan name="lidar_1" parent="emrox/base_link">
      <origin rpy="${pi} 0 ${pi/4}" xyz="${0.2995} 0.269 0.189"/>
    </xacro:sick_nanoscan>

    <xacro:sick_nanoscan name="lidar_2" parent="emrox/base_link">
      <origin rpy="${pi} 0 -${pi - pi/4}" xyz="-${0.2995} -0.269 0.189"/>
    </xacro:sick_nanoscan>
    
    <xacro:include filename="$(find rox_description)/urdf/xacros/cabinet.xacro" />
    <xacro:cabinet name="cabinet" parent="emrox/base_footprint">
      <origin rpy="0 0 0" xyz="0 0 0.33"/>
    </xacro:cabinet>
  </xacro:macro>

</robot>
