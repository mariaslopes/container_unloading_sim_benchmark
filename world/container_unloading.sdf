<?xml version="1.0" ?>
<sdf version="1.8">
    <world name="default">

        <physics name="1ms" type="ignored">
            <max_step_size>0.005</max_step_size>
            <real_time_factor>1.0</real_time_factor>
        </physics>
        
        <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
        <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
        <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
        <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>

        <gravity>0 0 -9.8</gravity>
        <magnetic_field>5.56e-06 2.28e-05 -4.23e-05</magnetic_field>
        <atmosphere type='adiabatic'/>

        <scene>
            <ambient>0.4 0.4 0.4 1</ambient>
            <background>0.7 0.7 0.7 1</background>
            <shadows>false</shadows>
        </scene>

        <gui fullscreen='true'>
            <camera name='user_camera'>
                <pose>-4.34 -3.63 1.68 0.0 0.15 0.58</pose>
                <view_controller>orbit</view_controller>
            </camera>
        </gui>

        <light name='sun' type='directional'>
            <pose>0 0 10 0 0 0</pose>
            <cast_shadows>false</cast_shadows>
            <intensity>1</intensity>
            <direction>-0.5 0.1 -0.9</direction>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
        </light>

        <light name="front_light" type="point">
            <pose>2.80 1.00 2.00 0 0 0</pose>
            <diffuse>1.0 0.95 0.88 1.0</diffuse>
            <specular>0.2 0.2 0.2 1.0</specular>
            <intensity>0.5</intensity>
            <cast_shadows>false</cast_shadows>
            <attenuation>
                <range>20</range>
                <constant>0.5</constant>
                <linear>0.01</linear>
                <quadratic>0.00</quadratic>
            </attenuation>
        </light>

        <light name="back_light" type="point">
            <pose>2.80 -0.37 1.00 0 0 0</pose>
            <diffuse>1.0 0.95 0.88 1.0</diffuse>
            <specular>0.2 0.2 0.2 1.0</specular>
            <intensity>0.5</intensity>
            <cast_shadows>false</cast_shadows>
            <attenuation>
                <range>20</range>
                <constant>0.5</constant>
                <linear>0.01</linear>
                <quadratic>0.00</quadratic>
            </attenuation>
        </light>

        <model name='ground_plane'>
            <static>true</static>
            <link name='link'>
                <collision name='collision'>
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>
                </collision>
                <visual name='visual'>
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>
                    <material>
                        <ambient>0.8 0.8 0.8 1</ambient>
                        <diffuse>0.8 0.8 0.8 1</diffuse>
                        <specular>0.8 0.8 0.8 1</specular>
                    </material>
                </visual>
            </link>
        </model>

